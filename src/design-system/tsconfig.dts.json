{
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist-types",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "lib": ["es2020", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "types": ["react", "react-dom"]
  },
  "include": ["index.ts", "*.tsx", "*.ts"],
  "exclude": ["*.stories.tsx", "dist-types"]
}
